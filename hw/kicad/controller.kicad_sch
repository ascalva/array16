  (global_label "GND" (shape passive) (at 335.28 243.84 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid bbb313ed-0c50-5a07-b734-ee3400364730) (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 0 0 0) (effects (font (size 1.27 1.27)) hide)))
  (wire (pts (xy 337.82 246.38) (xy 335.28 246.38)) (stroke (width 0) (type default)) (uuid 980c57f2-041b-5d36-9949-4ce127c69ac2))
  (label "SWD" (at 335.28 246.38 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid 0dae8c4d-846e-52be-8702-b26bc2853cc9))
  (text "Control word: bit i is output Q(i mod 8) of register i div 8. Bits 0-15 RX, 16-31 P180, 32-47 P90 (by element), 48 MODE, 49-52 QRX, 53 HRX, 54 CAL, 55 LNA2_EN." (at 30 20.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid 788d562b-9f9e-5670-9b7e-0476310ca917))
  (text "SR_OE_N is pulled high so the registers stay off until the firmware has shifted in zeros. GPIO20 takes the 40 MHz reference, GPIO22 the HackRF's 10 MHz." (at 30 24.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid ef0e69b4-498d-5bca-8be0-b428adba66c3))
  (text "The 12 MHz crystal keeps the RP2040's USB boot loader working; slot timing runs from the reference on GPIO20." (at 30 28.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid aea73a13-ec6f-5d97-8d9f-88347effcb8a))
)
